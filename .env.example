# Copy to .env and fill in. NEVER commit .env
DATABASE_URL=mysql://root:root@localhost:3306/skydesk
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=skydesk
# 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Passwords for the demo accounts created by `npm run db:setup` (choose your own)
DEMO_ADMIN_PASSWORD=
DEMO_PASSENGER_PASSWORD=
